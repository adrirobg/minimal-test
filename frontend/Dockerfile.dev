# Simple Development Dockerfile for Next.js Frontend
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Create directories
RUN mkdir -p uploads .next

# Expose port
EXPOSE 3000

# Development command with hot-reload
CMD ["npm", "run", "dev"]