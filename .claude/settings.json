{
  "permissions": {
    "allowedTools": [
      "Read",
      "Edit", 
      "MultiEdit",
      "Write",
      "Bash",
      "Glob",
      "Grep", 
      "LS",
      "TodoRead",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit"
    ],
    "ignorePatterns": [
      "node_modules/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "*.log",
      "*.sqlite",
      "*.db",
      ".env*",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "poetry.lock",
      "package-lock.json",
      "**/target/**"
    ]
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "MCP_TIMEOUT": "45000",
    "PYTHONPATH": "./src",
    "POETRY_VENV_IN_PROJECT": "true"
  },
  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30
}