# Environment Variables for Kairos BCP Production
# Copy this file to .env and modify the values for your environment

# Database Configuration
DB_NAME=kairos_bcp_prod
DB_USER=kairos_user
DB_PASSWORD=your_secure_database_password_here
DB_HOST=postgres
DB_PORT=5432

# Application Security
SECRET_KEY=your_very_secure_secret_key_minimum_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration  
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME=Kairos BCP

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Domain Configuration
DOMAIN_NAME=yourdomain.com

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Admin Tools
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=secure_pgadmin_password

# Monitoring (optional)
GRAFANA_PASSWORD=secure_grafana_password

# Backup Configuration (optional)
AWS_S3_BUCKET=your-backup-bucket
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Redis Configuration (optional)
REDIS_PASSWORD=your_redis_password

# SSL/TLS (for production)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem